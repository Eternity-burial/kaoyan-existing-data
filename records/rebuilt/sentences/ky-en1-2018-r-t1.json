    "sourceLocator": {
      "sIndex": 3,
      "id": "P3-S3",
      "pIndex": 3
    },
    "text": "The Industrial Revolution didn't go so well for Luddites whose jobs were displaced by mechanized looms, but it eventually raised living standards and created more jobs than it destroyed.",
    "translation": "工业革命对那些工作被机械织机所取代的卢德分子来说并不美好，但它最终提高了生活水平，所创造的就业岗位也超过了其摧毁的数量。",
    "syntaxAnalysis": {
      "structureType": "but连接的转折并列句 + 定语从句 + 比较从句",
      "mainClause": "The Industrial Revolution didn't go so well..., but it eventually raised... and created more jobs...",
      "modifiers": "whose 引导限制性定语从句修饰 Luddites；转折后 it 代指 Industrial Revolution，raised 和 created 为并列谓语；than it destroyed 为 than 引导的比较状语从句。",
      "corePattern": "go well for sb.（对某人进展顺利/有利）；displace A by B（用B替代A）；more... than...（比起……更多……）。"
    },
    "rawFields": {
      "isTopicSentence": false,
      "isKeyEvidence": true
    },
    "provenance": {
      "sourceLayer": "rebuilt",
      "sourceFile": "rebuilt_data/single_texts/text_2018_t1.json",
      "year": 2018,
      "articleKey": "ky-en1-2018-r-t1",
      "extractedAt": "2026-09-18T23:13:00+0800",
      "contentHash": "sha256:b866cd3d5fd2eafdccf4146e2f83c4061744b26814d9b81a8ce0b591689b3b31"
    }
  },
  {
    "schemaVersion": "kaoyan-existing-sentence-1.0",
    "source": "rebuilt",
