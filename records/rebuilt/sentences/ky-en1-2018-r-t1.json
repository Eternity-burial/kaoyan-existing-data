      "id": "P2-S3",
      "pIndex": 2
    },
    "text": "Lower-income jobs like gardening or day care don't appeal to robots.",
    "translation": "像园艺或日托这样的低收入工作，对机器人并没有吸引力。",
    "syntaxAnalysis": null,
    "rawFields": {
      "isTopicSentence": false,
      "isKeyEvidence": true
    },
    "provenance": {
      "sourceLayer": "rebuilt",
      "sourceFile": "rebuilt_data/single_texts/text_2018_t1.json",
