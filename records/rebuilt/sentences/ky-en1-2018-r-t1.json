    "sourceLocator": {
      "sIndex": 1,
      "id": "P4-S1",
      "pIndex": 4
    },
    "text": "The first step, as Erik Brynjolfsson and Andrew McAfee argue in The Second Machine Age, should be rethinking education and job training.",
    "translation": "正如埃里克·布莱恩约弗森和安德鲁·麦卡菲在《第二次机器革命》中所主张的那样，第一步应当是重新审视教育和职业培训。",
    "syntaxAnalysis": {
      "structureType": "主系表结构 + as引导的方式/非限制性定语插入从句",
      "mainClause": "The first step should be rethinking education and job training.",
      "modifiers": "as... argue in... 为 as 引导的插入语从句，意为“正如……所论证的”；should be 为情态系动词；rethinking 为动名词作表语。",
      "corePattern": "as sb. argue in...（正如某人在……中所指出的那样）；rethink sth.（反思/重新审视某事物）。"
    },
    "rawFields": {
      "isTopicSentence": true,
      "isKeyEvidence": true
    },
    "provenance": {
      "sourceLayer": "rebuilt",
      "sourceFile": "rebuilt_data/single_texts/text_2018_t1.json",
      "year": 2018,
      "articleKey": "ky-en1-2018-r-t1",
      "extractedAt": "2026-09-18T23:13:00+0800",
      "contentHash": "sha256:b866cd3d5fd2eafdccf4146e2f83c4061744b26814d9b81a8ce0b591689b3b31"
    }
  },
  {
    "schemaVersion": "kaoyan-existing-sentence-1.0",
    "source": "rebuilt",
    "articleKey": "ky-en1-2018-r-t1",
    "location": {
      "paragraph": 4,
