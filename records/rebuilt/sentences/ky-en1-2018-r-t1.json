    "sourceLocator": {
      "sIndex": 4,
      "id": "P3-S4",
      "pIndex": 3
    },
    "text": "Likewise, automation should eventually boost productivity, stimulate demand by driving down prices, and free workers from hard, boring work.",
    "translation": "同样地，自动化最终应当会促进生产力，通过压低价格来刺激需求，并将工人从艰辛枯燥的工作中解放出来。",
    "syntaxAnalysis": null,
    "rawFields": {
      "isTopicSentence": false,
      "isKeyEvidence": false
    },
    "provenance": {
      "sourceLayer": "rebuilt",
      "sourceFile": "rebuilt_data/single_texts/text_2018_t1.json",
      "year": 2018,
      "articleKey": "ky-en1-2018-r-t1",
      "extractedAt": "2026-09-18T23:13:00+0800",
      "contentHash": "sha256:b866cd3d5fd2eafdccf4146e2f83c4061744b26814d9b81a8ce0b591689b3b31"
    }
  },
  {
