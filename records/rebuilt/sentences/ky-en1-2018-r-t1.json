    "sourceLocator": {
      "sIndex": 5,
      "id": "P3-S5",
      "pIndex": 3
    },
    "text": "But in the medium term, middle-class workers may need a lot of help adjusting.",
    "translation": "但在中期阶段，中产阶级工人可能需要大量帮助来完成过渡适应。",
    "syntaxAnalysis": null,
    "rawFields": {
      "isTopicSentence": true,
      "isKeyEvidence": true
    },
    "provenance": {
