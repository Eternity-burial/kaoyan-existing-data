    "sourceLocator": {
      "sIndex": 2,
      "id": "P3-S2",
      "pIndex": 3
    },
    "text": "Optimists point out that technological upheaval has benefited workers in the past.",
    "translation": "乐观主义者指出，技术巨变在过去曾让劳动者获益。",
    "syntaxAnalysis": null,
    "rawFields": {
      "isTopicSentence": false,
      "isKeyEvidence": true
    },
    "provenance": {
      "sourceLayer": "rebuilt",
      "sourceFile": "rebuilt_data/single_texts/text_2018_t1.json",
      "year": 2018,
      "articleKey": "ky-en1-2018-r-t1",
