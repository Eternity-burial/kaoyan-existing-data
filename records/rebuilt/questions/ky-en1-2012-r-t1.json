    "stem": "In the author's view, Rosenberg's book fails to ______.",
    "stemTranslation": "在作者看来，罗森伯格的书未能做到______。",
    "options": [
      {
        "key": "A",
        "text": "adequately probe social and biological factors.",
        "translation": "充分探讨社会与生物因素",
        "isCorrect": true,
        "distractorType": "NONE",
        "distractorDisplayName": "正确答案",
        "analysis": "【正确项 · 双重否定逆向对应】对应第四段第2句：Join The Club is filled with too much irrelevant detail and not enough exploration of the social and biological factors...。not enough exploration（探索不足）与 fails to adequately probe（未能充分探究）构成严丝合缝的同义替换。",
        "vocab": [
          {
            "word": "probe",
            "ipa": "[prəʊb]",
            "meaning": "探究",
            "level": "red",
            "isSelfAnnotated": true
          },
          {
            "word": "factors",
            "ipa": "",
            "meaning": "因素",
            "level": "green",
            "isSelfAnnotated": false
          },
          {
            "word": "adequately",
            "ipa": "[ˈædɪkwətli]",
            "meaning": "充分地",
            "level": "red",
            "isSelfAnnotated": true
          }
        ],
        "selfAnnotated": true
      },
      {
        "key": "B",
        "text": "effectively evade the flaws of the social cure.",
        "translation": "有效规避社会疗法的缺陷",
        "isCorrect": false,
        "distractorType": "CONCEPT_DISTORTION",
        "distractorDisplayName": "偷换概念",
        "analysis": "【偷换概念】第四段指出该书展示的社会疗法本身存在明显缺陷（glaring flaw），并非书未能“逃避/规避（evade）”缺陷。",
        "vocab": [
          {
            "word": "evade",
            "ipa": "[ɪˈveɪd]",
            "meaning": "逃避",
            "level": "red",
            "isSelfAnnotated": true
          },
          {
            "word": "flaws",
            "ipa": "",
            "meaning": "缺点",
            "level": "green",
            "isSelfAnnotated": false
          }
        ],
        "selfAnnotated": true
      },
      {
        "key": "C",
        "text": "illustrate the functions of state funding.",
        "translation": "阐明州政府资金的功能",
        "isCorrect": false,
        "distractorType": "ATTRIBUTION_ERROR",
        "distractorDisplayName": "张冠李戴",
        "analysis": "【张冠李戴】文中提及‘对抗烟雾项目一旦失去州政府资助便失败’，是为了证明社会疗法效果不持久，而非书未能说明资金功能。",
        "vocab": [
          {
            "word": "illustrate",
            "ipa": "[ˈɪləstreɪt]",
            "meaning": "说明",
            "level": "green",
            "isSelfAnnotated": false
          },
          {
            "word": "functions",
            "ipa": "",
            "meaning": "功能",
            "level": "green",
            "isSelfAnnotated": false
          },
          {
            "word": "state",
            "ipa": "[steɪt]",
            "meaning": "州",
            "level": "green",
            "isSelfAnnotated": false
          }
        ],
        "selfAnnotated": false
      },
      {
        "key": "D",
        "text": "produce a long-lasting social effect.",
        "translation": "产生持久的社会效应",
        "isCorrect": false,
        "distractorType": "CONCEPT_DISTORTION",
        "distractorDisplayName": "偷换概念/主客颠倒",
        "analysis": "【偷换概念/主客颠倒】无法维持持久效应（doesn't work for very long）是‘社会疗法项目本身’的缺陷，而非作者批评‘这本书未能产生社会效应’。"
      }
    ],
    "officialAnswer": "A",
    "standardType": "DETAIL",
    "type": "事实细节题",
    "targetSentences": [
      "P4-S1",
      "P4-S2"
    ],
    "verbatimEvidence": "Join The Club is filled with too much irrelevant detail and not enough exploration of the social and biological factors that make peer pressure so powerful.",
    "synonymMapping": [
      {
        "verbatimText": "not enough exploration of the social and biological factors",
        "equivalentOption": "fails to adequately probe social and biological factors"
      }
    ],
    "methodologyReview": {
      "eliNotesSummary": "定位第四段第2句：Join The Club is filled with too much irrelevant detail and not enough exploration of the social and biological factors...。核心词映射：not enough exploration 对应 fails to adequately probe。probe 为 exploration 的高级动词替换。D 项偷换了评价对象，是社会疗法没能持久，不是这本书没产生持久效果。",
      "coreLesson": "同义替换之正反转述：原文‘not enough + 名词’（not enough exploration），常被改写为‘fails to + 副词 + 动词’（fails to adequately probe）。牢记 probe = explore。"
