            "level": "green",
            "isSelfAnnotated": false
          }
        ],
        "selfAnnotated": false
      },
      {
        "key": "C",
        "text": "Women are more experienced than men in coping with stress.",
        "isCorrect": false,
        "distractorType": "UNFOUNDED",
        "analysis": "无中生有。前两段讨论的是面对压力时的生理激素反应与易感性，只字未提女性在应对压力方面“比男性更有经验”。",
        "vocab": [
          {
            "word": "coping",
            "ipa": "",
            "meaning": "应付",
            "level": "green",
            "isSelfAnnotated": false
          },
          {
            "word": "Stress",
