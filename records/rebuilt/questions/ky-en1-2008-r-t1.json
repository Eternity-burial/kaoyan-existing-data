    "stem": "Which of the following is true according to the first two paragraphs?",
    "stemTranslation": null,
    "options": [
      {
        "key": "A",
        "text": "Women are biologically more vulnerable to stress.",
        "isCorrect": true,
        "distractorType": null,
        "analysis": "正确选项。第1段指出女性在面对压力时尤其容易患上抑郁和焦虑障碍（particularly susceptible to developing depression and anxiety disorders in response to stress）；第2段直接从内分泌生物学角度给出解释：性激素（sex hormones）导致处于压力下的雌性比同等条件下的雄性分泌更多触发化学物质，当切除卵巢（ovaries）消除雌激素影响后两性化学反应立刻相等。这充分且直接地证明了：女性在生理/生物学层面对压力更为脆弱敏感（biologically more vulnerable to stress），替换极具科学概括性。",
        "vocab": [
          {
            "word": "biologically",
            "ipa": "[ˌbaɪəˈlɒdʒɪkli]",
            "meaning": "易受…的伤害",
            "level": "green",
            "isSelfAnnotated": false
          },
          {
            "word": "stress",
            "ipa": "[stres]",
            "meaning": "压力",
            "level": "green",
            "isSelfAnnotated": false
          }
        ],
        "selfAnnotated": false
      },
      {
        "key": "B",
        "text": "Women are still suffering much stress caused by men.",
        "isCorrect": false,
        "distractorType": "ATTRIBUTION_ERROR",
        "analysis": "张冠李戴与主观歪曲。第1段第1句说的是女性在现代生活某些领域追赶男性（catching up to men），后文指出女性更容易遭受压力的侵袭，但前两段从未提及这些压力是“由男性造成的”（caused by men）。",
        "vocab": [
          {
            "word": "suffering",
            "ipa": "[ˈsʌfərɪŋ]",
            "meaning": "遭受",
            "level": "green",
