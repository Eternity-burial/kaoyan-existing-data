            "ipa": "[əˈnæləsɪs]",
            "meaning": "分析",
            "level": "green",
            "isSelfAnnotated": false
          }
        ],
        "selfAnnotated": false
      },
      {
        "key": "D",
        "text": "Men and women show different inclinations when faced with stress.",
        "isCorrect": false,
        "distractorType": "CONCEPT_DISTORTION",
        "analysis": "偷换概念。前两段论述的是两性面对压力时的生理内分泌与化学反应差异（chemical/biological response），而非心理或行为上的“倾向爱好（inclinations）”。",
        "vocab": [
          {
            "word": "Stress",
            "ipa": "[stres]",
            "meaning": "压力",
            "level": "green",
            "isSelfAnnotated": false
          },
          {
            "word": "Gender",
