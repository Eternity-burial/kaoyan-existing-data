    "qIndex": 27,
    "questionNumber": 27,
    "stem": "\"The industry\" (Line 5, Para. 3) refers to _______.",
    "stemTranslation": null,
    "options": [
      {
        "key": "A",
        "text": "online advertisers.",
        "isCorrect": true,
        "analysis": "定位至第三段 S8：“In February the FTC and Digital Advertising Alliance (DAA) agreed that the industry would get cracking on responding to DNT requests.” FTC 是代表公众利益的联邦监管部门，DAA 是‘数字广告联盟’。两者达成共识，承诺‘整个行业将迅速着手响应DNT请求’，显然这里的 the industry 指的就是 DAA 所代表的行业主体——在线广告商（online advertisers）。后文第4、5段全篇承接的也是 advertisers 的剧烈反弹与恐慌，进一步印证了其所指代的对象。"
      },
      {
        "key": "B",
        "text": "e-commerce conductors.",
        "isCorrect": false,
        "distractorType": "UNFOUNDED",
        "analysis": "无中生有。电子商务运营方并非本文探讨的谈判主体，争论双方核心是隐私监管方与网络广告投放联盟。",
        "vocab": [
          {
            "word": "conductors",
            "ipa": "",
            "meaning": "指挥（此处引申为运营商）",
            "level": "green",
            "isSelfAnnotated": false
          }
        ],
        "selfAnnotated": false
      },
      {
        "key": "C",
        "text": "digital information analysts.",
        "isCorrect": false,
        "distractorType": "UNFOUNDED",
        "analysis": "无中生有。文中从未出现‘数字信息分析师’这一行业主体概念。",
        "vocab": [
          {
            "word": "digital",
            "ipa": "[ˈdɪdʒɪt(ə)l]",
            "meaning": "数字式的",
            "level": "green",
            "isSelfAnnotated": false
          }
        ],
        "selfAnnotated": false
      },
      {
        "key": "D",
        "text": "internet browser developers.",
        "isCorrect": false,
        "distractorType": "CONCEPT_DISTORTION",
        "analysis": "张冠李戴。虽然第3段前文提到了微软IE、苹果Safari和谷歌Chrome等浏览器开发者，但协商协议的主体是‘FTC（政府监管者）和 DAA（数字广告联盟）’，DAA代表的是广告业，因此该协议中承诺做出响应的‘the industry’专指在线广告行业，而非浏览器开发商。"
      }
    ],
    "officialAnswer": "A",
    "standardType": "VOCAB",
    "type": null,
    "targetSentences": null,
    "verbatimEvidence": null,
    "synonymMapping": {
      "online advertisers": "Digital Advertising Alliance (DAA) -> the industry (数字广告联盟代表的行业主体即在线广告商群体)"
    },
    "methodologyReview": "代词/指代题。做考研代词与行业指代题，必须严格依据前置主语实体与联盟性质。与 FTC 谈判并做出承诺的是 Digital Advertising Alliance（数字广告联盟），由专有名词 Advertising Alliance 即可毫无悬念地锁定行业实体必为 online advertisers。【版本排版提示】在黄皮书、飞书精读与Eli讲义中，online advertisers 均排在 [A] 选项；在部分乱序版真题MD中，该项被排在 [D] 选项（部分网络试卷文末答案表误印为A，导致与题干选项冲突，做题时请认准实际文本 online advertisers 必为正确项）。",
    "paperVariants": {
