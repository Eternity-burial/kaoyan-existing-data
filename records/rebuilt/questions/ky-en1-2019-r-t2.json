        "refSentences": [
          "P5-S1"
        ]
      },
      {
        "key": "D",
        "text": "meet local governments' needs.",
        "isCorrect": false,
        "distractorType": "偷换主体利益",
        "analysis": "【干扰特征: 偏离核心】满足的是大学自身拿拨款的需求（satisfies colleges' own needs），非地方政府的需要。",
        "refSentences": [
          "P5-S1"
        ]
      }
    ],
