        "distractorType": "SCOPE_DISTORTION",
        "distractorDisplayName": "以偏概全/轻描淡写",
        "analysis": "【以偏概全】银行抱怨的不是‘重新评估’这一中性动作本身，而是痛恨该规则强制按低迷市价确认巨额账面亏损（unfavorable rules）。",
        "vocab": [
          {
            "word": "assets",
            "ipa": "",
            "meaning": "资产",
            "level": "green",
            "isSelfAnnotated": false
          }
