        "isCorrect": false,
        "distractorType": "UNFOUNDED",
        "analysis": "无中生有。原文提到 although they don't advertise that（尽管品牌不会给衣服只能洗一两次就扔做广告），但并未提及‘敦促消费者抵制广告影响’。",
        "vocab": [
          {
            "word": "resist",
            "ipa": "[rɪˈzɪst]",
            "meaning": "抵制",
            "level": "green",
            "isSelfAnnotated": false
