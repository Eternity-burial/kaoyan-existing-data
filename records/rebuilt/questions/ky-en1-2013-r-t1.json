        "selfAnnotated": false
      },
      {
        "key": "D",
        "text": "shut out the feverish fashion world.",
        "isCorrect": false,
        "distractorType": "CONCEPT_DISTORTION",
        "analysis": "张冠李戴。feverish world 是克莱恩用来描述快时尚行业那种狂热加速的失控状态，大众品牌拼命吸引消费者卷入其中，绝非敦促消费者将其‘拒之门外（shut out）’。",
        "vocab": [
          {
            "word": "shut",
            "ipa": "[ʃʌt]",
            "meaning": "把…排斥在外",
            "level": "red",
            "isSelfAnnotated": true
          },
          {
