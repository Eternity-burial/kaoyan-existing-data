        "selfAnnotated": true
      },
      {
        "key": "C",
        "text": "our awareness of potential risks.",
        "isCorrect": false,
        "distractorType": "CONTRADICTION",
        "analysis": "时空混淆与正反颠倒。第二段明确指出，对各种潜在风险（小行星、流感、气候变化）的认识是‘现在（Now）’导致乌托邦幻灭的原因，绝非‘过去（used to be）’激发积极未来愿景的因素。",
        "vocab": [
          {
