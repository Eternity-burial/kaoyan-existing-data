            "level": "green",
            "isSelfAnnotated": false
          },
          {
            "word": "risk",
            "ipa": "[rɪsk]",
            "meaning": "风险",
            "level": "green",
            "isSelfAnnotated": false
          }
        ],
        "selfAnnotated": false
      }
    ],
    "officialAnswer": "D",
    "standardType": "DETAIL",
    "type": null,
