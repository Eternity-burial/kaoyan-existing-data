            "ipa": "[ˌʌnɪmˈplɔɪmənt]",
            "meaning": "失业",
            "level": "green",
            "isSelfAnnotated": false
          },
          {
            "word": "insurance",
            "ipa": "[ɪnˈʃʊərəns]",
            "meaning": "保险",
            "level": "green",
            "isSelfAnnotated": false
          }
        ],
        "selfAnnotated": true
      }
    ],
