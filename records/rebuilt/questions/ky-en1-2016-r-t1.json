        "key": "D",
        "text": "The fashion industry would decline.",
        "isCorrect": false,
        "distractorType": "CONCEPT_DISTORTION",
        "analysis": "【偷换概念】时尚产业丧失的是定义美的垄断特权（lost an absolute right to define beauty），并不等于时尚产业整体衰退走向衰败（decline）。",
        "refSentences": [
          "P1-S1"
        ],
        "vocab": [
          {
            "word": "fashion",
            "ipa": "[ˈfæʃ(ə)n]",
            "meaning": "时尚",
            "level": "green",
            "isSelfAnnotated": false
          },
