  {
    "schemaVersion": "kaoyan-existing-sentence-1.0",
    "source": "production",
    "articleKey": "ky-en1-2000-r-t2",
    "location": {
      "paragraph": 3,
      "sentence": 7,
      "ps": "P3-S7"
    },
    "sourceLocator": {
      "sIndex": 7,
      "id": "P3-S7",
      "pIndex": 3
    },
    "text": "But in the past 100,000 years—even the past 100 years—our lives have been transformed but our bodies have not.",
    "translation": "但在过去的十万年里，甚至在过去的一百年里，我们的生活已经发生了改变，但我们的身体却没有。",
    "syntaxAnalysis": null,
    "rawFields": {
      "isTopicSentence": false,
      "isKeyEvidence": false
    },
    "provenance": {
      "sourceLayer": "production",
      "sourceFile": "题库/英语/data_2000.js",
      "year": 2000,
      "articleKey": "ky-en1-2000-r-t2",
