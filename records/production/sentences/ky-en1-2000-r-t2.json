    "sourceLocator": {
      "sIndex": 6,
      "id": "P3-S6",
      "pIndex": 3
    },
    "text": "No other species fills so many places in nature.",
    "translation": "没有其他物种占据了自然界如此多的地方。",
    "syntaxAnalysis": null,
    "rawFields": {
      "isTopicSentence": false,
      "isKeyEvidence": false
