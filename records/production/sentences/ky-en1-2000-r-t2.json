      "contentHash": "sha256:3f9a5388ad11097f9557bbf5154a5917cfd6524a94745a49b350362d9a74b695"
    }
  },
  {
    "schemaVersion": "kaoyan-existing-sentence-1.0",
    "source": "production",
    "articleKey": "ky-en1-2000-r-t2",
    "location": {
      "paragraph": 3,
      "sentence": 8,
      "ps": "P3-S8"
    },
    "sourceLocator": {
      "sIndex": 8,
      "id": "P3-S8",
      "pIndex": 3
    },
    "text": "We did not evolve, because machines and society did it for us.",
    "translation": "我们没有进化，因为机器和社会为我们进化了。",
    "syntaxAnalysis": null,
    "rawFields": {
      "isTopicSentence": false,
      "isKeyEvidence": false
    },
    "provenance": {
      "sourceLayer": "production",
      "sourceFile": "题库/英语/data_2000.js",
