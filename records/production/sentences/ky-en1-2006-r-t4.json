    },
    "sourceLocator": {
      "sIndex": 6,
      "id": "P3-S6",
      "pIndex": 3
    },
    "text": "The things that bring the greatest joy carry the greatest potential for loss and disappointment.",
    "translation": "那些能带来最大快乐的事情也有可能带来最大的损失和失望。",
    "syntaxAnalysis": null,
    "rawFields": {
      "isTopicSentence": false,
      "isKeyEvidence": false
    },
    "provenance": {
      "sourceLayer": "production",
