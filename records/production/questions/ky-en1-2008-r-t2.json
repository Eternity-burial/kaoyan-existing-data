  {
    "schemaVersion": "kaoyan-existing-question-1.0",
    "source": "production",
    "articleKey": "ky-en1-2008-r-t2",
    "qIndex": 27,
    "questionNumber": 27,
    "stem": "Which of the following is true of the OECD report?",
    "stemTranslation": null,
    "options": [
      {
        "key": "A",
        "text": "It criticizes government-funded research.",
        "isCorrect": false,
        "distractorType": "CONTRADICTION",
        "analysis": "正反混淆。OECD 报告批评的是商业出版商利用政府资助的科研成果筑起付费墙牟取暴利，它坚决支持政府资助的科研成果全面向公众开放获取，绝非批评科研本身。",
        "vocab": [
          {
            "word": "criticizes",
            "ipa": "",
            "meaning": "批评",
            "level": "green",
            "isSelfAnnotated": false
          }
        ],
        "selfAnnotated": false
      },
      {
        "key": "B",
        "text": "It introduces an effective means of publication.",
        "isCorrect": false,
        "distractorType": "SCOPE_DISTORTION",
        "analysis": "偷换概念与张冠李戴。OECD 报告是一份深度分析政策与行业经济影响的研究报告，它是在客观描述（describing）正在涌现的新兴商业模式，其自身并未‘引入一种有效的出版手段’。",
        "vocab": [
          {
            "word": "effective",
            "ipa": "[ɪˈfektɪv]",
            "meaning": "有效的",
            "level": "green",
            "isSelfAnnotated": false
          },
          {
            "word": "means",
            "ipa": "[miːnz]",
            "meaning": "方法",
            "level": "red",
            "isSelfAnnotated": true
          },
          {
            "word": "publication",
            "ipa": "[ˌpʌblɪˈkeɪʃn]",
            "meaning": "出版",
            "level": "green",
            "isSelfAnnotated": false
          }
        ],
        "selfAnnotated": true
      },
      {
        "key": "C",
        "text": "It upsets profit-making journal publishers.",
        "isCorrect": true,
        "distractorType": null,
        "analysis": "正确选项。第2段第4句精准定位：'The report... makes heavy reading for publishers who have, so far, made handsome profits.' heavy reading 是一句极富表现力的英语地道表达，意为‘读起来令人心情沉重、难以消受’；publishers who have made handsome profits 指的就是营利性商业出版商（profit-making journal publishers）。报告宣告了免费获取时代的到来，敲响了出版垄断暴利的丧钟，因此让出版商大为不安与沉重（upsets profit-making journal publishers），同义替换极为传神。",
        "vocab": [
          {
            "word": "upsets",
            "ipa": "",
            "meaning": "使心烦意乱",
            "level": "green",
            "isSelfAnnotated": false
          }
        ],
        "selfAnnotated": false
      },
      {
        "key": "D",
        "text": "It benefits scientific research considerably.",
        "isCorrect": false,
        "distractorType": "ATTRIBUTION_ERROR",
        "analysis": "张冠李戴。真正使科学研究大幅受益的是‘科研成果免费开放获取（free access to scientific results）’本身，而非 OECD 撰写的这份分析报告直接带来了巨大的科研收益。",
        "vocab": [
          {
            "word": "benefits",
            "ipa": "/ˈbenɪfɪts/",
            "meaning": "使受益",
            "level": "green",
            "isSelfAnnotated": false
          }
        ],
        "selfAnnotated": false
      }
    ],
    "officialAnswer": "C",
    "standardType": "DETAIL",
    "type": null,
    "targetSentences": null,
    "verbatimEvidence": null,
