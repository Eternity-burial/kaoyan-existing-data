    "stem": "With the open-access publishing model, the author of a paper is required to _______.",
    "stemTranslation": null,
    "options": [
      {
        "key": "A",
        "text": "cover the cost of its publication.",
        "isCorrect": true,
        "distractorType": null,
        "analysis": "正确选项。第4段第5句精准定位：在论述三种新模式中的开放获取出版时，原文明确指出：'There is open-access publishing, typically supported by asking the author (or his employer) to pay for the paper to be published.' 要求作者（或雇主）为论文发表付费，这正是学术界众所周知的 APC（论文处理费），即要求作者自身‘承担发表的成本费用（cover the cost of its publication）’，同义转述完全一致。",
        "vocab": [
          {
            "word": "publication",
            "ipa": "[ˌpʌblɪˈkeɪʃn]",
            "meaning": "出版",
            "level": "green",
            "isSelfAnnotated": false
          }
        ],
        "selfAnnotated": false
      },
      {
        "key": "B",
        "text": "subscribe to the journal publishing it.",
        "isCorrect": false,
        "distractorType": "CONTRADICTION",
        "analysis": "正反颠倒与张冠李戴。第1段指出在传统模式下才需要读者出资订阅（subscribe to the journal）；而开放获取模式的核心特征正是对读者端完全免费开放，作者无需订阅。",
        "vocab": [
          {
            "word": "subscribe",
            "ipa": "[səbˈskraɪb]",
            "meaning": "订阅",
            "level": "green",
            "isSelfAnnotated": false
          },
          {
            "word": "publishing",
            "ipa": "",
            "meaning": "出版",
            "level": "green",
            "isSelfAnnotated": false
          }
        ],
        "selfAnnotated": false
      },
      {
        "key": "C",
        "text": "allow other online journals to use it freely.",
        "isCorrect": false,
        "distractorType": "UNFOUNDED",
        "analysis": "无中生有。原文从未规定作者必须允许其他在线期刊自由使用该论文。"
      },
      {
        "key": "D",
        "text": "complete the peer-review before submission.",
        "isCorrect": false,
        "distractorType": "CONTRADICTION",
        "analysis": "颠倒时序流程。同行评审（peer-review）是在作者投稿之后由期刊编辑组织学术同行进行的，作者不可能在投稿之前（before submission）自行完成同行评审。"
      }
    ],
