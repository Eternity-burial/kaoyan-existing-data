    "stem": "In the first paragraph, the author discusses _______.",
    "stemTranslation": null,
    "options": [
      {
        "key": "A",
        "text": "the background information of journal editing.",
        "isCorrect": false,
        "distractorType": "SCOPE_DISTORTION",
        "analysis": "以偏概全。期刊编辑（journal editor）隐去作者信息送审只是首段全流程中的一个环节，不能概括整段讨论的投稿、盲审、出版、版权归属和读者订阅的全套流程。",
        "vocab": [
          {
            "word": "editing",
            "ipa": "",
            "meaning": "编辑",
            "level": "green",
            "isSelfAnnotated": false
          }
        ],
        "selfAnnotated": false
      },
      {
        "key": "B",
        "text": "the publication routine of laboratory reports.",
        "isCorrect": false,
        "distractorType": "CONCEPT_DISTORTION",
        "analysis": "偷换概念。第1段讲述的是实验室科学家将科研成果投递给学术期刊发表（scientific paper/journal publication），而不是企业或实验室内部的日常‘实验报告（laboratory reports）’。",
        "vocab": [
          {
            "word": "publication",
            "ipa": "[ˌpʌblɪˈkeɪʃn]",
            "meaning": "出版",
            "level": "green",
            "isSelfAnnotated": false
          },
          {
            "word": "routine",
            "ipa": "[ruːˈtiːn]",
            "meaning": "常规",
            "level": "green",
            "isSelfAnnotated": false
          }
        ],
        "selfAnnotated": false
      },
      {
        "key": "C",
        "text": "the relations of authors with journal publishers.",
        "isCorrect": false,
        "distractorType": "SCOPE_DISTORTION",
        "analysis": "以偏概全。首段不仅涉及作者与出版商，还详细描述了同行审稿人、编辑的角色以及寻求知识的读者订阅，是对整个出版运转流程的系统陈述。",
        "vocab": [
          {
            "word": "authors",
            "ipa": "",
            "meaning": "作者",
            "level": "green",
            "isSelfAnnotated": false
          }
        ],
        "selfAnnotated": false
      },
      {
        "key": "D",
        "text": "the traditional process of journal publication.",
        "isCorrect": true,
        "distractorType": null,
        "analysis": "正确选项。首段开篇用 'It used to be so straightforward' 设立历史回溯基调，随后按先后时间顺序严谨罗列了学术期刊发表的一整套传统步骤：研究团队提交论文成果 $\rightarrow$ 编辑隐去姓名机构送同行双盲评审 $\rightarrow$ 根据审稿意见录用或拒稿 $\rightarrow$ 版权归出版商所有 $\rightarrow$ 读者出资订阅。选项 D 'the traditional process of journal publication'（学术期刊出版的传统流程）是对全段核心内容最完美、最高度的概括。",
        "vocab": [
          {
            "word": "process",
            "ipa": "[prəˈses; ˈprəʊses]",
            "meaning": "进程",
            "level": "green",
            "isSelfAnnotated": false
          },
          {
            "word": "publication",
            "ipa": "[ˌpʌblɪˈkeɪʃn]",
            "meaning": "出版",
            "level": "green",
            "isSelfAnnotated": false
          }
        ],
        "selfAnnotated": false
      }
    ],
