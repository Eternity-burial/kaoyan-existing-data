    "stem": "Monarchs are kept as heads of state in Europe mostly _______.",
    "stemTranslation": null,
    "options": [
      {
        "key": "A",
        "text": "owing to their undoubted and respectable status.",
        "isCorrect": true,
        "analysis": "定位至第三段末句：“...most royal families have survived because they allow voters to avoid the difficult search for a non-controversial but respected public figure.” 欧洲绝大多数王室之所以得以幸存，是因为他们使选民免去了寻找一位‘无可争议但受人尊敬的公众人物’的麻烦。这正说明君主自身具备 non-controversial（无可置疑，同义替换为 undoubted）与 respected（受人尊敬，同义替换为 respectable）的地位。",
        "vocab": [
          {
            "word": "look",
            "ipa": "[lʊk]",
            "meaning": "尊敬，敬仰",
            "level": "green",
            "isSelfAnnotated": false
          }
        ],
        "selfAnnotated": false
      },
      {
        "key": "B",
        "text": "to achieve a balance between tradition and reality.",
        "isCorrect": false,
        "distractorType": "UNFOUNDED",
        "analysis": "无中生有。第三段中完全未提及在传统与现实之间取得平衡（balance between tradition and reality）。",
        "vocab": [
          {
            "word": "balance",
            "ipa": "[ˈbæləns]",
            "meaning": "平衡",
            "level": "green",
            "isSelfAnnotated": false
          },
          {
            "word": "tradition",
            "ipa": "[trəˈdɪʃ(ə)n]",
            "meaning": "传统",
            "level": "green",
            "isSelfAnnotated": false
          },
          {
            "word": "reality",
            "ipa": "[riˈæləti]",
            "meaning": "现实",
            "level": "green",
            "isSelfAnnotated": false
          }
        ],
        "selfAnnotated": false
      },
      {
        "key": "C",
        "text": "to give voters more public figures to look up to.",
        "isCorrect": false,
        "distractorType": "CONCEPT_DISTORTION",
        "analysis": "偷换概念与正反颠倒。第三段明确说君主制“allow voters to avoid the difficult search for a non-controversial but respected public figure”（让选民免于去费力寻找公众人物），绝非为了给选民提供‘更多（more）’可以瞻仰的公众人物。",
        "vocab": [
          {
            "word": "owing",
            "ipa": "[ˈəʊɪŋ]",
            "meaning": "把.归因于.",
            "level": "green",
            "isSelfAnnotated": false
          },
          {
            "word": "status",
            "ipa": "[ˈsteɪtəs]",
            "meaning": "地位",
            "level": "green",
            "isSelfAnnotated": false
          }
        ],
        "selfAnnotated": false
      },
      {
        "key": "D",
        "text": "due to their everlasting political embodiment.",
        "isCorrect": false,
        "distractorType": "CONTRADICTION",
        "analysis": "正反矛盾与曲解文意。第二段强调君主能够超越‘纯粹’政治（rise above 'mere' politics），第三段首句亦强调其政治超越性（transcendence of politics），绝非因其具备‘永恒的政治化身（everlasting political embodiment）’。",
        "vocab": [
          {
            "word": "due",
            "ipa": "[djuː]",
            "meaning": "由于，因为",
            "level": "green",
            "isSelfAnnotated": false
          }
        ],
        "selfAnnotated": false
      }
    ],
    "officialAnswer": "A",
    "standardType": "DETAIL",
    "type": null,
