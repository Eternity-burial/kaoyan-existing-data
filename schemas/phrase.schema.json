{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KaoyanExistingPhraseRecord",
  "type": "object",
  "required": [
    "schemaVersion",
    "source",
    "articleKey",
    "surface",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "kaoyan-existing-phrase-1.0"
    },
    "source": {
      "type": "string",
      "enum": ["production", "rebuilt"]
    },
    "articleKey": {
      "type": "string",
      "pattern": "^ky-en1-\\d{4}-r-t\\d+$"
    },
    "surface": {
      "type": "string"
    },
    "location": {
      "type": ["string", "null"]
    },
    "contextMeaning": {
      "type": ["string", "null"]
    },
    "rawFields": {
      "type": "object"
    },
    "provenance": {
      "type": "object",
      "required": ["sourceLayer", "sourceFile", "year", "articleKey", "extractedAt", "contentHash"]
    }
  }
}
